# Required: Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: Your Telegram chat ID (message @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Poll interval in hours (default: 4)
# POLL_INTERVAL_HOURS=4

# Optional: Minimum executives for alert (default: 3)
# MIN_EXECUTIVES=3

# Optional: Minimum transaction value in USD (default: 200000)
# MIN_TRANSACTION_VALUE=200000

# Optional: Days of data to fetch per poll (default: 7)
# LOOKBACK_DAYS=7
